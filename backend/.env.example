# ── RepuestosYa Backend — Variables de entorno (copiar a .env) ──────────────
# Copia este archivo a backend/.env y completa los valores. NO versionar .env.
# En producción las variables obligatorias se validan al arranque: si falta
# alguna, el proceso termina con mensaje claro (ver src/config/env.js).

# Puerto HTTP del servidor Express. Render lo inyecta automáticamente.
PORT=3000

# development | production
# En producción: validación estricta de variables, HTTPS obligatorio,
# console.* silenciado y logging de requests desactivado salvo LOG_LEVEL=debug.
NODE_ENV=development

# Nivel de logging: info | debug.
# En producción, debug activa el registro de requests (método, ruta, status,
# ms) en Morgan/timing. Nunca se registran headers de Authorization, bodies
# de login ni tokens (hallazgo B4).
LOG_LEVEL=info

# Lista separada por comas de orígenes permitidos por CORS en PRODUCCIÓN.
# Valor exacto del despliegue: https://repuestos-ya-vert.vercel.app
# (sin barra final; la app móvil no usa CORS).
ALLOWED_ORIGINS=

# Supabase (URL del proyecto y credenciales).
SUPABASE_URL=
# Solo para operaciones server-side (consulta directa a la DB con bypass de
# RLS). NUNCA se usa en endpoints públicos.
SUPABASE_SERVICE_ROLE_KEY=
# Requerida por /auth/refresh (operación de cliente). OBLIGATORIA en
# producción: sin ella el proceso no arranca y /auth/refresh responde 500
# (hallazgo B8 — no hay fallback a la service-role key).
SUPABASE_ANON_KEY=

# JWT propio del backend (firmado con estas credenciales).
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256

# Redis: caché (src/services/cache.js) + cola de notificaciones BullMQ
# (src/queues/notificaciones.queue.js y src/workers/notificaciones.worker.js).
# OBLIGATORIA en producción: usar el Redis free de Render o un Redis externo
# (Upstash, Railway, etc.). Formato: redis://default:password@host:port
REDIS_URL=

# Geocodificación server-side (Nominatim): país configurable.
GEOCODING_COUNTRY=Ecuador
GEOCODING_COUNTRYCODES=ec

# Solo para el fixture E2E (backend/scripts/e2e_fixture.js).
E2E_ALMACEN_PASSWORD=
