# ── RepuestosYa Backend — Variables de entorno (copiar a .env) ──────────────
# Copia este archivo a `backend/.env` y completa los valores. NO versionar .env.

# Puerto HTTP del servidor Express.
PORT=3000

# development | production
# En producción se desactiva console.* y Morgan registra solo método, ruta y status.
NODE_ENV=development

# Lista separada por comas de orígenes permitidos por CORS en PRODUCCIÓN.
# Ejemplo: https://app.repuestosya.com,https://admin.repuestosya.com
# En desarrollo se usa la allowlist local de server.js.
ALLOWED_ORIGINS=

# Supabase (URL del proyecto y credenciales).
SUPABASE_URL=
# Solo para operaciones server-side (consulta directa a la DB con bypass de
# RLS). NUNCA se usa en endpoints públicos.
SUPABASE_SERVICE_ROLE_KEY=
# Requerida por /auth/refresh (operación de cliente); sin ella el endpoint
# responde 500 "Servicio de autenticación no configurado".
SUPABASE_ANON_KEY=

# JWT propio del backend (firmado con estas credenciales).
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256
