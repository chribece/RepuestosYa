# ── RepuestosYa Admin Panel — Variables de entorno ──────────────────────────
# Copia este archivo a .env.local para desarrollo y define la variable en
# Vercel (Project -> Settings -> Environment Variables) para producción.

# URL base de la API del backend. Puede llevar o no el sufijo /api; el panel
# lo normaliza automáticamente.
#   Producción (Vercel): https://repuestosya.onrender.com
#   Desarrollo local:    http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
